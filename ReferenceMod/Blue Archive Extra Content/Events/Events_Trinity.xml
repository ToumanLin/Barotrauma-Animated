              <NPCFollowAction npctag="jtfmember1" targettag="triggerer_player" follow="true" />
              <ConversationAction targettag="triggerer_player" speakertag="jtfmember1" text="Thank you for helping us, miss Ichika should be here somewhere, we'll look for her" eventsprite="portrait_jtfmember3">
                <Option text="Okay">
                  <ConversationAction targettag="triggerer_player" text="I wonder where she would be, maybe the nearby office? We're supposed to report to her immediately." eventsprite="portrait_jtfmember4" />
                </Option>
              </ConversationAction>
              <NPCFollowAction npctag="jtfmember1" targettag="ichika" follow="true" />
              <ConversationAction targettag="triggerer_player" speakertag="ichika" text="eventtext.BAstudent_Trinity_quest2.d1" eventsprite="portrait_Ichika9">
                <Option text="Next">
                  <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1" eventsprite="portrait_jtfmember3">
                    <Option text="Next">
                      <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1.d1" eventsprite="portrait_Ichika8">
                        <Option text="Hello!">
                          <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1.d2" eventsprite="portrait_Ichika6">
                            <Option text="It's my pleasure">
                              <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1.d1.d1" eventsprite="portrait_Ichika20">
                                <Option text="The girls had already paid the trip, so we're all good.">
                                  <SpawnAction itemidentifier="ba_spawner_jtfreinforcement_crew" targetinventory="triggerer_player" />
                                  <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1.d1.d1.d1" eventsprite="portrait_Ichika2">
                                    <Option text="That sounds quite handy.">
                                      <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1.d1.d1.d1.d1" eventsprite="portrait_jtfmember4">
                                        <Option text="Sure, I'll call you when the time come, I think we all needed to support each other, especially in Europa">
                                          <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1.d1.d1.d1.d1.d1" eventsprite="portrait_Ichika22">
                                            <Option text="Will we meet again?">
                                              <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1.d1.d1.d1.d1.d1.d1" eventsprite="portrait_Ichika2">
                                                <Option text="That sounds good!">
                                                  <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1.d1.d1.d1.d1.d1.d1.d1" eventsprite="portrait_Ichika21">
                                                    <Option text="Next">
                                                      <NPCFollowAction npctag="ichika" targettag="admin" follow="false" />
                                                      <WaitAction time="0.5" />
                                                      <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest2.d1.d1.d1.d1.d1.d1.d1.d1.d1.d1" eventsprite="portrait_Ichika1" />
                                                      <TagAction criteria="hullname:centralaccesspassage" tag="centralaccesspassage" submarinetype="Outpost" />
                                                      <NPCFollowAction npctag="ichika" targettag="centralaccesspassage" follow="true" />
                                                    </Option>
                                                  </ConversationAction>
                                                </Option>
                                              </ConversationAction>
                                            </Option>
                                          </ConversationAction>
                                        </Option>
                                      </ConversationAction>
                                    </Option>
                                  </ConversationAction>
                                </Option>
                              </ConversationAction>
                            </Option>
                          </ConversationAction>
                        </Option>
                      </ConversationAction>
                    </Option>
                  </ConversationAction>
                </Option>
              </ConversationAction>
              <WaitAction time="5.0" />
              <ConversationAction targettag="triggerer_player" speakertag="ichika" text="Don't mind us, we're just waiting for our vessel." eventsprite="portrait_Ichika20" />
              <WaitAction time="5.0" />
              <ConversationAction targettag="triggerer_player" speakertag="ichika" text="Is something wrong?" eventsprite="portrait_Ichika22" />
              <WaitAction time="5.0" />
              <ConversationAction targettag="triggerer_player" speakertag="ichika" text="Eheh..." eventsprite="portrait_Ichika20" />
              <WaitAction time="5.0" />
              <ConversationAction targettag="triggerer_player" speakertag="ichika" text="..." eventsprite="portrait_Ichika6" />
            </Success>
          </CheckDataAction>
        </Success>
      </CheckDataAction>
    </ScriptedEvent>
