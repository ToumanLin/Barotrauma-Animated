  <!--Trinity questline-->
  <!--escorts 3 jtf members to ichika-->
  <EventPrefabs>
    <ScriptedEvent identifier="BAstudent_Trinity_quest1" commonness="100">
      <CheckDataAction identifier="mission_escort_jtfcrewtransport1_completed" condition="gt 0">
        <Failure>
          <TagAction criteria="player" tag="player" />
          <SpawnAction speciesname="Human" npcsetidentifier="set_jtf" npcidentifier="jtf_assault" targettag="jtfmember1" spawnlocation="Outpost" targetmoduletags="airlock,cityairlock" />
          <SpawnAction speciesname="Human" npcsetidentifier="set_jtf" npcidentifier="jtf_rifleman" targettag="jtfmember2" spawnpointtag="jtfmember1" />
          <SpawnAction speciesname="Human" npcsetidentifier="set_jtf" npcidentifier="jtf_rifleman" targettag="jtfmember3" spawnpointtag="jtfmember2" />
          <NPCFollowAction npctag="jtfmember2" targettag="jtfmember1" follow="true" />
          <NPCFollowAction npctag="jtfmember3" targettag="jtfmember2" follow="true" />
          <TriggerAction target1tag="jtfmember1" target2tag="player" applytotarget2="triggerer_player" waitforinteraction="true" />
          <NPCFollowAction npctag="jtfmember1" targettag="triggerer_player" follow="true" />
          <ConversationAction targettag="triggerer_player" speakertag="jtfmember1" text="eventtext.BAstudent_Trinity_quest1.d1" eventsprite="portrait_jtfmember2">
            <Option text="eventtext.BAstudent_Trinity_quest1.d1.o1">
              <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest1.o1.d1" eventsprite="portrait_jtfmember6">
                <Option text="eventtext.BAstudent_Trinity_quest1.o1.o1">
                  <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest1.o1.o1.d1" eventsprite="portrait_jtfmember4" />
                  <NPCFollowAction npctag="jtfmember1" targettag="triggerer_player" follow="false" />
                  <MissionAction missiontag="mission_escort_jtfcrewtransport1" />
                </Option>
                <Option text="eventtext.BAstudent_Trinity_quest1.o1.o2">
                  <ConversationAction targettag="triggerer_player" text="eventtext.BAstudent_Trinity_quest1.o1.o2.d1" eventsprite="portrait_jtfmember5" />
                  <NPCFollowAction npctag="jtfmember1" targettag="triggerer_player" follow="false" />
                </Option>
              </ConversationAction>
            </Option>
          </ConversationAction>
        </Failure>
      </CheckDataAction>
    </ScriptedEvent>
    <!--after finished the last mission, the jtfs spawns with ichika, there is no quest for this-->
    <ScriptedEvent identifier="BAstudent_Trinity_quest2" commonness="100">
      <CheckDataAction identifier="BAstudent_Trinity_quest2_completed" condition="eq 0">
        <Success>
          <CheckDataAction identifier="mission_escort_jtfcrewtransport1_completed" condition="gt 0">
            <Success>
              <TagAction criteria="player" tag="player" />
              <SpawnAction speciesname="human" npcsetidentifier="set_trinity" npcidentifier="npc_ichika" targettag="ichika" spawnlocation="Outpost" targetmoduletags="adminmodule" />
              <SpawnAction speciesname="human" npcsetidentifier="set_jtf" npcidentifier="jtf_assault" targettag="jtfmember1" spawnlocation="Outpost" targetmoduletags="airlock,cityairlock" />
              <SpawnAction speciesname="human" npcsetidentifier="set_jtf" npcidentifier="jtf_rifleman" targettag="jtfmember2" spawnpointtag="jtfmember1" />
              <SpawnAction speciesname="human" npcsetidentifier="set_jtf" npcidentifier="jtf_rifleman" targettag="jtfmember3" spawnpointtag="jtfmember2" />
