    <!--check whether mission is completed, if not reset and give the quests again-->
    <ScriptedEvent identifier="BAstudent_Trinity_quest3_return" commonness="100">
      <CheckDataAction identifier="BAstudent_Trinity_quest3_completed" condition="gt 0">
        <Success>
          <CheckDataAction identifier="mission_destroy_gehennainterceptor_completed" condition="gt 0">
            <Failure>
              <CheckReputationAction targettype="faction" identifier="trinity" condition="gte 0">
                <Success>
                  <TagAction criteria="player" tag="player" />
                  <TagAction criteria="hullname:admin" tag="admin" submarinetype="Outpost" />
                  <SpawnAction speciesname="human" npcsetidentifier="set_trinity" npcidentifier="npc_ichika" targettag="ichika" spawnlocation="Outpost" targetmoduletags="airlock,cityairlock" />
                  <SpawnAction speciesname="human" npcsetidentifier="set_jtf" npcidentifier="jtf_assault" targettag="jtfmember1" spawnlocation="Outpost" targetmoduletags="airlock,cityairlock" />
                  <NPCFollowAction npctag="jtfmember1" targettag="ichika" follow="true" />
                  <TriggerAction target1tag="ichika" target2tag="player" applytotarget2="triggerer_player" waitforinteraction="true" />
                  <NPCFollowAction npctag="ichika" targettag="triggerer_player" follow="true" />
                  <ConversationAction text="Hello there, it seems like we weren't able to deal with the Interceptor..." speakertag="ichika" endeventifinterrupted="false" eventsprite="portrait_Ichika8">
                    <Option text="We should try again, maybe we can find a way this time.">
                      <ConversationAction text="Thank you, I will report to the student council for further reports." eventsprite="portrait_Ichika1"></ConversationAction>
                      <MissionAction missiontag="missionevent_gehennasub1" />
                      <NPCFollowAction npctag="ichika" targettag="triggerer_player" follow="false" />
                      <WaitAction time="3" />
                      <NPCFollowAction npctag="ichika" targettag="admin" follow="true" />
                    </Option>
                    <Option text="I'm sorry Ichika, but me and the crew don't want to meddles with Trinity's affair anymore.">
                      <ConversationAction text="Is that so, well that's unfortuante." eventsprite="portrait_Ichika6">
                        <Option text="I'm sorry Ichika, maybe not this time.">
                          <ConversationAction text="Is that so, well that's unfortuante, if you want to help us in the future you know where to find us." eventsprite="portrait_Ichika7"></ConversationAction>
                          <NPCFollowAction npctag="ichika" targettag="triggerer_player" follow="false" />
                        </Option>
                      </ConversationAction>
                    </Option>
                  </ConversationAction>
                </Success>
              </CheckReputationAction>
            </Failure>
          </CheckDataAction>
        </Success>
      </CheckDataAction>
    </ScriptedEvent>
