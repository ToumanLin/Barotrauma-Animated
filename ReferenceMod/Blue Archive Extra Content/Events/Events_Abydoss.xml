    <!--event has to split as doing CheckVisibilityAction causes NPCFollowAction to stop working properly-->
    <ScriptedEvent identifier="Abydos_Quest_BankRobbing_Tutorial_2">
      <TagAction criteria="player" tag="player" />
      <TagAction criteria="humanprefabidentifier:npc_shiroko_neutral" tag="shiroko" />
      <TagAction criteria="humanprefabidentifier:npc_nonomi_neutral" tag="nonomi" />
      <TagAction criteria="itemtag:shiroko_chair" tag="shiroko_chair" />
      <TagAction criteria="itemtag:nonomi_chair" tag="nonomi_chair" />
      <TagAction criteria="itemtag:drill_drop_location" tag="drill_drop_location" />
      <TagAction criteria="itemtag:shiroko_tutorial" tag="shiroko_tutorial" />
      <TagAction criteria="itemtag:spawn_shiroko" tag="spawn_shiroko" />
      <TagAction criteria="itemtag:nonomi_tutorial" tag="nonomi_tutorial" />
      <TagAction criteria="itemtag:spawn_nonomi" tag="spawn_nonomi" />
      <TagAction criteria="itemtag:ba_drill_bag" tag="drill_bag1" />
      <Label name="reset_check" />
      <WaitAction time="2" />
      <CheckVisibilityAction EntityTag="shiroko_tutorial" TargetTag="shiroko" maxdistance="200">
        <Success>
          <!--<AfflictionAction affliction="ba_minigame_da_stop" strength="1" targettag="shiroko" />
					<AfflictionAction affliction="ba_minigame_da_stop" strength="1" targettag="nonomi" />-->
          <TriggerAction target1tag="shiroko" target2tag="player" waitforinteraction="true" />
          <ConversationAction targettag="player" WaitForInteraction="false" text="EventText.Abydos_Shiroko_Bankrob_Tutorial1" eventsprite="Shiroko_Expression_2" />
          <EventObjectiveAction type="completeandremove" identifier="EventText.Abydos_Shiroko_Bankrob_Tutorial_Follow" />
          <!--pick up bag-->
          <EventObjectiveAction type="add" identifier="EventText.Abydos_Shiroko_Bankrob_Tutorial_Pickup" />
          <StatusEffectAction targettag="drill_bag1">
            <StatusEffect target="This" noninteractable="false" />
          </StatusEffectAction>
          <HighlightAction targettag="drill_bag1" />
          <TriggerAction target1tag="drill_bag1" target2tag="player" applytotarget2="triggerer_player" waitforinteraction="true" />
          <RemoveItemAction targettag="drill_bag1" />
          <SpawnAction itemidentifier="backpack_bank" targettag="drill_bag2" targetinventory="triggerer_player" Equip="true" />
          <EventObjectiveAction type="completeandremove" identifier="EventText.Abydos_Shiroko_Bankrob_Tutorial_Pickup" />
          <EventObjectiveAction type="add" identifier="EventText.Abydos_Shiroko_Bankrob_Tutorial_Deliver" />
          <!--nonomi retreats-->
          <!--installs drill-->
          <ConversationAction targettag="player" WaitForInteraction="false" text="EventText.Abydos_Shiroko_Bankrob_Tutorial2" eventsprite="Shiroko_Expression_1" />
          <SpawnAction itemidentifier="ba_drill_location" targettag="drill_highlight" spawnpointtag="drill_drop_location" offset="0" />
          <Label name="drill_in_position_check" />
          <WaitAction time="2" />
          <CheckVisibilityAction EntityTag="drill_bag2" TargetTag="drill_drop_location" maxdistance="100">
            <Success>
              <RemoveItemAction targettag="drill_bag2" />
              <EventObjectiveAction type="completeandremove" identifier="EventText.Abydos_Shiroko_Bankrob_Tutorial_Deliver" />
              <SpawnAction itemidentifier="backpack_bank" targettag="drill_bag3" spawnpointtag="drill_drop_location" offset="0" ignorebyai="true" />
              <StatusEffectAction targettag="drill_bag3">
                <StatusEffect target="This" noninteractable="true" />
              </StatusEffectAction>
              <SpawnAction itemidentifier="ba_bankrobbingdrill_godmode" targettag="drill_godmode" spawnpointtag="drill_spawn_location" offset="0" />
              <RemoveItemAction targettag="drill_highlight" />
              <GoTo name="drill_in_position_completed" />
            </Success>
            <Failure>
              <GoTo name="drill_in_position_check" />
            </Failure>
          </CheckVisibilityAction>
          <Label name="drill_in_position_completed" />
          <ConversationAction targettag="player" WaitForInteraction="false" text="EventText.Abydos_Shiroko_Bankrob_Tutorial3" eventsprite="Shiroko_Expression_1" />
          <ConversationAction targettag="player" text="EventText.Abydos_Shiroko_Bankrob_Tutorial4" eventsprite="Shiroko_Expression_13" continueconversation="true" />
          <WaitAction time="2" />
          <StatusEffectAction targettag="drill_godmode">
            <StatusEffect target="This" condition="0" setvalue="true" />
          </StatusEffectAction>
          <EventObjectiveAction type="add" identifier="EventText.Abydos_Shiroko_Bankrob_Tutorial_Fix_Drill" />
          <ConversationAction targettag="player" WaitForInteraction="false" text="EventText.Abydos_Shiroko_Bankrob_Tutorial5" eventsprite="Shiroko_Expression_13" continueconversation="true" />
          <ConversationAction targettag="player" text="EventText.Abydos_Shiroko_Bankrob_Tutorial6" eventsprite="Shiroko_Expression_14" continueconversation="true" />
          <!--Check for repaired drill-->
          <Label name="drill_fix_pending" />
          <WaitAction time="2" />
          <CheckConditionalAction targettag="drill_godmode">
            <Conditional condition="eq 5" />
            <Success>
              <EventObjectiveAction type="completeandremove" identifier="EventText.Abydos_Shiroko_Bankrob_Tutorial_Fix_Drill" />
              <ConversationAction targettag="player" WaitForInteraction="false" text="EventText.Abydos_Shiroko_Bankrob_Tutorial7" eventsprite="Shiroko_Expression_2" />
              <ConversationAction targettag="player" text="EventText.Abydos_Shiroko_Bankrob_Tutorial8" eventsprite="Shiroko_Expression_14" continueconversation="true" />
              <ConversationAction targettag="player" text="EventText.Abydos_Nonomi_Bankrob_Tutorial9" eventsprite="Nonomi_Expression_14" continueconversation="true" />
              <ConversationAction targettag="player" text="EventText.Abydos_Shiroko_Bankrob_Tutorial10" eventsprite="Shiroko_Expression_14" continueconversation="true" />
              <ConversationAction targettag="player" text="EventText.Abydos_Nonomi_Bankrob_Tutorial11" eventsprite="Nonomi_Expression_4" continueconversation="true" />
              <ConversationAction targettag="player" text="EventText.Abydos_Shiroko_Bankrob_Tutorial12" eventsprite="Shiroko_Expression_12" continueconversation="true" />
              <!--releases affiction allowing Shiroko and Nonomi next turn, to move again-->
              <AfflictionAction affliction="ba_minigame_da_stop" strength="-100" targettag="shiroko" />
              <NPCOperateItemAction npctag="shiroko" targettag="shiroko_chair" ItemComponentName="Controller" Operate="true" />
              <ConversationAction targettag="player" text="EventText.Abydos_Nonomi_Bankrob_Tutorial13" eventsprite="Nonomi_Expression_6" continueconversation="true" />
              <ConversationAction targettag="player" text="EventText.Abydos_Nonomi_Bankrob_Tutorial14" eventsprite="Nonomi_Expression_7" endconversation="true" />
              <AfflictionAction affliction="ba_minigame_da_stop" strength="-100" targettag="nonomi" />
              <NPCFollowAction npctag="nonomi" targettag="nonomi_tutorial" follow="false" />
              <NPCFollowAction npctag="shiroko" targettag="shiroko_tutorial" follow="false" />
              <StatusEffectAction targettag="drill_godmode">
                <StatusEffect target="This" tags="offline" duration="infinity" />
              </StatusEffectAction>
              <StatusEffectAction targettag="drill_drop_location">
                <StatusEffect target="This" noninteractable="false">
                  <!--<Sound file="%ModDir%/Content/Sounds/SFX/Drill_startup.ogg" range="1000" />-->
                </StatusEffect>
              </StatusEffectAction>
              <NPCOperateItemAction npctag="nonomi" targettag="nonomi_chair" ItemComponentName="Controller" Operate="true" />
            </Success>
            <Failure>
              <GoTo name="drill_fix_pending" />
            </Failure>
          </CheckConditionalAction>
        </Success>
        <Failure>
          <GoTo name="reset_check" />
        </Failure>
      </CheckVisibilityAction>
    </ScriptedEvent>
