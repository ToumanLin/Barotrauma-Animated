    <ScriptedEvent identifier="Abydos_Quest_BankRobbing_Tutorial_1">
      <TagAction criteria="player" tag="player" />
      <TagAction criteria="humanprefabidentifier:npc_shiroko_neutral" tag="shiroko" />
      <TagAction criteria="humanprefabidentifier:npc_nonomi_neutral" tag="nonomi" />
