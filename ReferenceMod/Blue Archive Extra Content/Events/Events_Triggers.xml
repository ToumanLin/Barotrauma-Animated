    <!--Blue Archive Event-->
    <ScriptedEvent identifier="arona_giveloot_event" tags="arona_giveloot_event">
      <TagAction criteria="player" tag="player" />
      <SpawnAction speciesname="arona" npcsetidentifier="set_none" npcidentifier="npc_arona" targettag="arona" spawnpointtag="triggerer_player" teamtag="1" />
      <Label name="reset" />
      <ClearTagAction tag="triggerer_player" />
      <ClearTagAction tag="envelope" />
      <ConversationAction text="Gacha?" invokertag="triggerer_player" endeventifinterrupted="false" eventsprite="Arona_Expression_2" speakertag="arona">
        <Option text="Yes">
          <ConversationAction text="What would you want to do?" targettag="triggerer_player" endeventifinterrupted="false" eventsprite="Arona_Expression_31">
            <!--single-->
            <Option text="Single Rolls">
              <CheckItemAction targettag="triggerer_player" itemidentifiers="gachaticket1">
                <Success>
                  <RemoveItemAction targettag="triggerer_player" itemidentifier="gachaticket1" />
                  <SpawnAction itemidentifier="envelopes_archive" targettag="envelope" targetinventory="triggerer_player" Equip="true" />
                  <GoTo name="gacha10" />
                </Success>
                <Failure>
                  <ConversationAction text="Sensei You don't have any ticket for this action!" targettag="triggerer_player" endeventifinterrupted="false" eventsprite="Arona_Expression_26" />
                  <GoTo name="reset" />
                </Failure>
              </CheckItemAction>
            </Option>
            <!--10 rolls-->
            <Option text="x10 Rolls">
              <CheckItemAction targettag="triggerer_player" itemidentifiers="gachaticket10">
                <Success>
                  <RemoveItemAction targettag="triggerer_player" itemidentifier="gachaticket10" />
                  <SpawnAction itemidentifier="envelopes_archive" targettag="envelope" targetinventory="triggerer_player" Equip="true" />
                  <GoTo name="gacha1" />
                </Success>
                <Failure>
                  <ConversationAction text="Sensei You don't have enough ticket for this action!" targettag="triggerer_player" endeventifinterrupted="false" eventsprite="Arona_Expression_26" />
                  <GoTo name="reset" />
                </Failure>
              </CheckItemAction>
            </Option>
          </ConversationAction>
        </Option>
        <Option text="Nevermind">
          <ConversationAction text="Hmm~" targettag="triggerer_player" endeventifinterrupted="false" eventsprite="Arona_Expression_33" />
          <Goto name="reset" />
        </Option>
      </ConversationAction>
      <!--GACHA TIME!!!!-->
