    <!--Moe-->
    <ScriptedEvent identifier="moe_idle_event1" tags="moe_idle_event1" commonness="0">
      <TagAction criteria="player" tag="player" />
      <TagAction criteria="humanprefabidentifier:npc_moe" tag="moe" />
      <!--BROKEN FOR SOME REASON-->
      <Label name="action_moe_reset" />
      <WaitAction time="1" />
      <CheckDataAction identifier="is_moe_idling" condition="eq 1">
        <Success>
          <SpawnAction itemidentifier="baemote_assignmentboard" targettag="baemote_assignmentboard" targetinventory="moe" Equip="true" />
          <WaitAction time="5" />
          <GoTo name="action_moe_reset" />
        </Success>
        <Failure>
          <RemoveItemAction targettag="moe" itemidentifiers="baemote_assignmentboard" />
          <WaitAction time="5" />
          <GoTo name="action_moe_reset" />
        </Failure>
      </CheckDataAction>
    </ScriptedEvent>
