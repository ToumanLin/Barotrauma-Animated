        <RequiredSkill identifier="medical" level="40" />
        <!--play sound when used-->
        <StatusEffect type="OnUse" target="UseTarget">
          <Conditional HealthPercentage="lt 100" />
          <Sound file="Content/Items/Medical/Bandage1.ogg" range="500" />
          <Sound file="Content/Items/Medical/Bandage2.ogg" range="500" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This,Character" comparison="and" statuseffecttags="speaching" duration="10" delay="0" stackable="false">
          <Conditional HasStatusTag="!eq speaching" />
          <Conditional HealthPercentage="lte 50" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This,Character" delay="0" stackable="false" comparison="and">
          <Conditional HasStatusTag="!eq speaching" />
          <Conditional HealthPercentage="lte 50" />
          <Forcesay message="medicalpack.used" sayinradio="true" />
        </StatusEffect>
        <!--heal when HP upper 90%-->
        <StatusEffect type="OnSuccess" target="This,UseTarget" Condition="-0.4" duration="5" stackable="true" comparison="and">
          <Conditional HealthPercentage="gt 85" />
          <Conditional HealthPercentage="lt 100" />
          <reduceAffliction type="damage" amount="1.0" />
          <reduceAffliction type="burn" amount="0.5" />
        </StatusEffect>
        <StatusEffect type="OnFailure" target="This,UseTarget" Condition="-0.5" duration="4" stackable="true" comparison="and">
          <Conditional HealthPercentage="gt 85" />
          <Conditional HealthPercentage="lt 100" />
          <reduceAffliction type="damage" amount="1.0" />
          <reduceAffliction type="burn" amount="0.5" />
        </StatusEffect>
        <!--heal when HP upper 50%-->
        <StatusEffect type="OnSuccess" target="This,UseTarget" Condition="-2.0" duration="5" stackable="true" comparison="and">
          <Conditional HealthPercentage="gt 50" />
          <Conditional HealthPercentage="lte 85" />
          <reduceAffliction type="damage" amount="5" />
          <reduceAffliction type="burn" amount="2.5" />
        </StatusEffect>
        <StatusEffect type="OnFailure" target="This,UseTarget" Condition="-2.0" duration="5" stackable="true" comparison="and">
          <Conditional HealthPercentage="gt 50" />
          <Conditional HealthPercentage="lte 85" />
          <reduceAffliction type="damage" amount="4" />
          <reduceAffliction type="burn" amount="2" />
        </StatusEffect>
        <!--heal when HP lower 50%-->
        <StatusEffect type="OnSuccess" target="This,UseTarget" Condition="-4.0" duration="5" stackable="true" comparison="and">
          <Conditional HealthPercentage="lte 50" />
          <reduceAffliction type="damage" amount="10" />
          <reduceAffliction type="burn" amount="5" />
          <SteamTimeLineEvent title="Using Medical Pack" description="Some one used the Med-Pack at low health" icon="steam_bolt" />
        </StatusEffect>
        <StatusEffect type="OnFailure" target="This,UseTarget" Condition="-4.0" duration="5" stackable="true" comparison="and">
          <Conditional HealthPercentage="lte 50" />
          <reduceAffliction type="damage" amount="8" />
          <reduceAffliction type="burn" amount="4" />
          <SteamTimeLineEvent title="Using Medical Pack" description="Some one used the Med-Pack at low health" icon="steam_bolt" />
        </StatusEffect>
        <!--heal when get bleeding-->
        <StatusEffect type="OnSuccess" target="This, Limb" Condition="-1.25" duration="4.0" stackable="true" CheckConditionalAlways="true" comparison="or">
          <Conditional bleeding="gt 0" />
          <Conditional bleedingnonstop="gt 0" />
          <reduceAffliction type="bleeding" amount="15" />
        </StatusEffect>
        <StatusEffect type="OnFailure" target="This, Limb" Condition="-1.25" duration="4.0" stackable="true" CheckConditionalAlways="true" comparison="or">
          <Conditional bleeding="gt 0" />
          <Conditional bleedingnonstop="gt 0" />
          <reduceAffliction type="bleeding" amount="10" />
        </StatusEffect>
        <!--heal when get would infection-->
        <StatusEffect type="OnSuccess" target="This,Limb" Condition="-1.25" duration="4.0" stackable="true" CheckConditionalAlways="true">
          <Conditional infection="gt 0" />
          <reduceAffliction type="infection" amount="15" />
        </StatusEffect>
        <StatusEffect type="OnFailure" target="This,Limb" Condition="-1.25" duration="4.0" stackable="true" CheckConditionalAlways="true">
          <Conditional infection="gt 0" />
          <reduceAffliction type="infection" amount="10" />
        </StatusEffect>
        <!--heal when get bloodloss-->
        <StatusEffect type="OnSuccess" target="This,UseTarget" Condition="-1.25" duration="4.0" stackable="true" CheckConditionalAlways="true">
          <Conditional bloodloss="gt 0" />
          <reduceAffliction type="bloodloss" amount="15" />
        </StatusEffect>
        <StatusEffect type="OnFailure" target="This,UseTarget" Condition="-1.25" duration="4.0" stackable="true" CheckConditionalAlways="true">
          <Conditional bloodloss="gt 0" />
          <reduceAffliction type="bloodloss" amount="10" />
        </StatusEffect>
        <!-- Remove the item when fully used -->
        <StatusEffect type="OnBroken" target="This">
          <Remove />
        </StatusEffect>
