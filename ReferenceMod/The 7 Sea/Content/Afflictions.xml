  <Affliction name="Kraken Using Fallback Attack" identifier="krakententacleattacking" type="Logical" limbspecific="false" indicatorlimb="Torso" maxstrength="100" showiconthreshold="1000" showinhealthscannerthreshold="1000">
    <Effect minstrength="0" maxstrength="100" strengthchange="-5">
      <StatusEffect type="OnDamaged" target="Character" disabledeltatime="true" stackable="false">
        <ReduceAffliction identifier="krakententacleattacking" amount="5" />
      </StatusEffect>
      <StatusEffect type="OnDamaged" target="Character" disabledeltatime="true" stackable="false">
        <RequiredAffliction type="damage,burn" minstrength="30" />
        <ReduceAffliction identifier="krakententacleattacking" amount="55" />
      </StatusEffect>
      <StatusEffect type="OnDamaged" target="This" onlyplayertriggered="true">
        <Conditional isdead="False" />
        <RequiredAffliction type="damage,burn" minstrength="30" />
        <AITrigger state="Escape" duration="10" probability="1" mindamage="100" allowtobeoverridden="false" allowtooverride="true" />
        <!-- Railgun hit on the head -->
        <AITrigger state="Escape" duration="6" probability="1" mindamage="50" allowtobeoverridden="true" allowtooverride="true" />
        <!-- Coilgun hit in the mouth -->
        <AITrigger state="Escape" duration="4" probability="1" mindamage="30" allowtobeoverridden="true" allowtooverride="false" />
      </StatusEffect>
      <StatusEffect type="OnDamaged" target="This" onlyplayertriggered="true">
        <Conditional isdead="False" />
        <RequiredAffliction type="damage,burn" minstrength="1" />
        <AITrigger state="Escape" duration="4" probability="0.15" mindamage="1" allowtobeoverridden="true" allowtooverride="false" />
      </StatusEffect>
      <StatusEffect target="Character" type="OnActive">
        <TriggerAnimation Type="SwimFast" path="%ModDir%/Content/Characters/Kthulakarn/KthulakarnFallbackSwimFast.xml" priority="8.0" ExpectedSpecies="Kthulakarn" />
        <TriggerAnimation Type="SwimSlow" path="%ModDir%/Content/Characters/Kthulakarn/KthulakarnFallbackSwimSlow.xml" priority="8.0" ExpectedSpecies="Kthulakarn" />
      </StatusEffect>
    </Effect>
    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="128,640,128,128" color="195,177,60,255" origin="0,0" />
  </Affliction>
