      </StatusEffect>
      <!-- revert hold position adjustment when walking -->
      <StatusEffect type="OnActive" target="This" holdpos="0,-15" handle1="-30,-5" holdangle="170" setvalue="true" interval="1.1">
        <Conditional InWater="false" />
