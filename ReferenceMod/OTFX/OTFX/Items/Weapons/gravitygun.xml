<?xml version="1.0" encoding="utf-8"?>
<Items>
  <Item name="" identifier="otfx_gravitysphereprojectile" tags="smallitem,handheldammo,harpoonammo" maxstacksize="32" maxstacksizecharacterinventory="8" showcontentsintooltip="true" category="Weapon" sonarsize="5" scale="0.5" impactsoundtag="" cargocontaineridentifier="">
