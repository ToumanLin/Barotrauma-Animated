        <sound file="Content/Items/Weapons/GRAVITYSHELLS_loop.ogg" volume="2" range="3000" loop="true" />
      </StatusEffect>
      <StatusEffect type="OnActive" target="This" delay="10.0" stackable="false" condition="0.0" setvalue="true" />
