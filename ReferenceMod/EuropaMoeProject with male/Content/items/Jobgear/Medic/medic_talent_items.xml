        <sprite name="Headset Wearable" texture="%ModDir%/Content/Items/JobGear/TalentGear.png" sourcerect="253,305,76,58" limb="Head" hidelimb="false" inheritlimbdepth="true" inheritscale="true" ignorelimbscale="true" scale="0.6" hideotherwearables="false" origin="0.5,0.5" />
      </Wearable>
