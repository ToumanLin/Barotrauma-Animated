      </Effect>
    </Affliction>
    <Affliction name="XdsWalking" identifier="XdsWalking" type="buff" isbuff="true" limbspecific="false" indicatorlimb="Head" showiconthreshold="1000" maxstrength="1">
      <Effect minstrength="0" maxstrength="1" strengthchange="-0.5">
        <StatusEffect target="Character">
          <TriggerAnimation Type="Walk" FileName="HumanWalk-XDS" priority="1" ExpectedSpecies="Human" />
          <TriggerAnimation Type="Run" FileName="HumanRun-XDS" priority="10" ExpectedSpecies="Human" />
          <TriggerAnimation Type="SwimSlow" FileName="HumanSwimSlow_XDS_01" priority="10" ExpectedSpecies="Human" />
          <TriggerAnimation Type="SwimFast" FileName="HumanSwimFast_XDS_01" priority="10" ExpectedSpecies="Human" />
        </StatusEffect>
