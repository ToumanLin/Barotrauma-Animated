			},
			"(hidelimb=\"true\")": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#c7d239",
						"fontWeight": "bold"
					}
				]
			},
			"(hideinmenus=\"true\")": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#2e124c",
						"backgroundColor": "#d28b39",
						"fontWeight": "bold"
					}
				]
			},
			"(origin)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#4eba3b",
						"fontWeight": "bold"
					}
				]
			},
			"(waifu_maid)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#4eba3b",
						"fontWeight": "bold"
					}
				]
			},
			"(waifu_tightswim)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#4eba3b",
						"fontWeight": "bold"
					}
				]
			},
		},
		"files.exclude": {
			"**/*.png": true,
			"**/*.sub": true,
			"**/*.ogg": true,
			"**/00_RELEASE": true,
			"**/00_TEST": true,
		},
		"search.exclude": {
			"**/00_RELEASE": true,
			"**/00_TEST": true,
		},
		"editor.tabSize": 2
	},
}