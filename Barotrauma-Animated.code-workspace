{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "../../Content"
		},
		{
			"path": "../OTFX"
		},
		{
			"path": "../S.A.F.S"
		}
	],
	"settings": {
		"highlight.regexes": {

			"((?:<!-- *)?(?:#|// @|//|./\\*+|<!--|--|\\* @|{!|{{!--|{{!) *MOD FEATURE(?:\\s*\\([^)]+\\))?:?)((?!\\w)(?: *-->| *\\*/| *!}| *--}}| *}}|(?= *(?:[^:]//|/\\*+|<!--|@|--|{!|{{!--|{{!))|(?: +[^\\n@]*?)(?= *(?:[^:]//|/\\*+|<!--|@|--(?!>)|{!|{{!--|{{!))|(?: +[^@\\n]+)?))": {
				"filterFileRegex": ".*(?<!CHANGELOG.md)$",
				"decorations": [
					{
						"overviewRulerColor": "#1d9df3",
						"backgroundColor": "#1d9df3",
						"color": "#1f1f1f",
						"fontWeight": "bold"
					},
					{
						"backgroundColor": "#ffcc00",
						"color": "#1f1f1f"
					}
				]
			},
			"((?:<!-- *)?(?:#|// @|//|./\\*+|<!--|--|\\* @|{!|{{!--|{{!) *COPY VANILLA(?:\\s*\\([^)]+\\))?:?)((?!\\w)(?: *-->| *\\*/| *!}| *--}}| *}}|(?= *(?:[^:]//|/\\*+|<!--|@|--|{!|{{!--|{{!))|(?: +[^\\n@]*?)(?= *(?:[^:]//|/\\*+|<!--|@|--(?!>)|{!|{{!--|{{!))|(?: +[^@\\n]+)?))": {
				"filterFileRegex": ".*(?<!CHANGELOG.md)$",
				"decorations": [
					{
						"backgroundColor": "#1d5af3",
						"color": "#1f1f1f",
						"fontWeight": "bold"
					},
					{
						"backgroundColor": "#ffcc00",
						"color": "#1f1f1f"
					}
				]
			},
			"((?:<!-- *)?(?:#|// @|//|./\\*+|<!--|--|\\* @|{!|{{!--|{{!) *EVENT END(?:\\s*\\([^)]+\\))?:?)((?!\\w)(?: *-->| *\\*/| *!}| *--}}| *}}|(?= *(?:[^:]//|/\\*+|<!--|@|--|{!|{{!--|{{!))|(?: +[^\\n@]*?)(?= *(?:[^:]//|/\\*+|<!--|@|--(?!>)|{!|{{!--|{{!))|(?: +[^@\\n]+)?))": {
				"filterFileRegex": ".*(?<!CHANGELOG.md)$",
				"decorations": [
					{
						"backgroundColor": "#41f31d",
						"color": "#1f1f1f",
						"fontWeight": "bold"
					},
					{
						"backgroundColor": "#ffcc00",
						"color": "#1f1f1f"
					}
				]
			},
			// Matches ModDir in the texture attribute
			"(ModDir)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"backgroundColor": "#1d9df3",
						"color": "#000000",
						"fontWeight": "bold"
					}
				]
			},
			"(:2809175631)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"backgroundColor": "#09c939",
						"color": "#000000",
						"fontWeight": "bold"
					}
				]
			},
			// Match work in progess item
			"(waifu_wip)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"backgroundColor": "#c9c309",
						"color": "#000000",
						"fontWeight": "bold"
					}
				]
			},
			// subcategory
			"(waifu_cosplay)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#4eba3b",
						"fontWeight": "bold"
					}
				]
			},
			"(sourcerect)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#4eba3b",
						"fontWeight": "bold"
					}
				]
			},
			"(OnSuccess)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#4eba3b",
						"fontWeight": "bold"
					}
				]
			},
			"(depthlimb)": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#a5259f",
						"fontWeight": "bold"
					}
				]
			},
			"(disabledeltatime=\"true\")": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#a5259f",
						"fontWeight": "bold"
					}
				]
			},
			"(inheritsourcerect=\"false\")": {
				"filterFileRegex": "\\.xml$",
				"decorations": [
					{
						"color": "#a5259f",
						"fontWeight": "bold"
